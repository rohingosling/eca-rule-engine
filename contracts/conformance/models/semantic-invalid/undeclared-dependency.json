{
  "schemaVersion": "1.0",
  "id": "undeclared-dependency",
  "name": "Undeclared dependency",
  "parameters": [
    {
      "id": "source",
      "name": "Source",
      "type": "string"
    }
  ],
  "payloads": [
    {
      "id": "signal-payload",
      "name": "Signal payload",
      "parameters": [
        "source"
      ]
    }
  ],
  "events": [
    {
      "id": "signal.received",
      "name": "Signal received",
      "payload": "signal-payload"
    }
  ],
  "conditions": [
    {
      "id": "level.high",
      "name": "Level high",
      "dependencies": [
        "level"
      ],
      "predicate": {
        "name": "greaterThan",
        "arguments": {
          "parameter": "level",
          "value": 10
        }
      }
    }
  ],
  "actions": [
    {
      "id": "alert",
      "name": "Alert",
      "parameters": {}
    }
  ],
  "rules": [
    {
      "id": "alert.high",
      "name": "Alert high",
      "event": "signal.received",
      "condition": "level.high",
      "action": "alert"
    }
  ]
}
