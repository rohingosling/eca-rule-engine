{
  "schemaVersion": "1.0",
  "id": "incompatible-comparison-value",
  "name": "Incompatible comparison value",
  "parameters": [
    {
      "id": "level",
      "name": "Level",
      "type": "number"
    }
  ],
  "payloads": [
    {
      "id": "signal-payload",
      "name": "Signal payload",
      "parameters": [
        "level"
      ]
    }
  ],
  "events": [
    {
      "id": "signal.received",
      "name": "Signal received",
      "payload": "signal-payload"
    }
  ],
  "conditions": [
    {
      "id": "level.matches",
      "name": "Level matches",
      "dependencies": [
        "level"
      ],
      "predicate": {
        "name": "equals",
        "arguments": {
          "parameter": "level",
          "value": "high"
        }
      }
    }
  ],
  "actions": [
    {
      "id": "alert",
      "name": "Alert",
      "parameters": {}
    }
  ],
  "rules": [
    {
      "id": "alert.match",
      "name": "Alert match",
      "event": "signal.received",
      "condition": "level.matches",
      "action": "alert"
    }
  ]
}
