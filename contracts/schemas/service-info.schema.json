{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eca-rule-engine.example/schemas/v1/service-info.schema.json",
  "title": "ECA service information",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation",
    "version",
    "apiVersion",
    "supportedSchemaVersions",
    "predicates",
    "activeModelAvailable"
  ],
  "properties": {
    "implementation": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "const": "1"
    },
    "supportedSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activeModelAvailable": {
      "type": "boolean"
    },
    "activeModelId": {
      "$ref": "model.schema.json#/$defs/identifier"
    },
    "activeModelSchemaVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "activeModelAvailable": {
            "const": true
          }
        },
        "required": [
          "activeModelAvailable"
        ]
      },
      "then": {
        "required": [
          "activeModelId",
          "activeModelSchemaVersion"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "activeModelId"
              ]
            },
            {
              "required": [
                "activeModelSchemaVersion"
              ]
            }
          ]
        }
      }
    }
  ]
}
