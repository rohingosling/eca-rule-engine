{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eca-rule-engine.example/schemas/v1/model.schema.json",
  "title": "Stateless ECA model",
  "description": "A version 1 model containing reusable parameter and payload definitions, event types, conditions, actions, and rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "parameters",
    "payloads",
    "events",
    "conditions",
    "actions",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "$ref": "#/$defs/displayName"
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "parameters": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/parameterDefinition"
      }
    },
    "payloads": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/payloadDefinition"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/eventType"
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "parameterDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "type": {
          "enum": [
            "null",
            "boolean",
            "number",
            "integer",
            "string",
            "array",
            "object"
          ]
        },
        "description": {
          "$ref": "#/$defs/description"
        }
      }
    },
    "payloadDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "parameters": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "eventType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "payload": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "predicate": {
      "oneOf": [
        {
          "$ref": "#/$defs/alwaysPredicate"
        },
        {
          "$ref": "#/$defs/comparisonPredicate"
        }
      ]
    },
    "alwaysPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "const": "always"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    "comparisonPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "enum": [
            "equals",
            "notEquals",
            "greaterThan",
            "greaterThanOrEqual",
            "lessThan",
            "lessThanOrEqual",
            "contains"
          ]
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parameter",
            "value"
          ],
          "properties": {
            "parameter": {
              "$ref": "#/$defs/identifier"
            },
            "value": true
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "dependencies",
        "predicate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "predicate": {
          "$ref": "#/$defs/predicate"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "predicate": {
                "properties": {
                  "name": {
                    "const": "always"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "predicate"
            ]
          },
          "then": {
            "properties": {
              "dependencies": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "dependencies": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "event",
        "condition",
        "action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "$ref": "#/$defs/displayName"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "event": {
          "$ref": "#/$defs/identifier"
        },
        "condition": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
